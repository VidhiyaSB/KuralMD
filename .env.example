# Copy to .env and fill in. Never commit .env.
# Local Ollama (default). Pull the model first: ollama pull gemma4:e4b
OLLAMA_URL=http://localhost:11434
MODEL_NAME=gemma4:e4b
FALLBACK_MODEL_NAME=gemma4:e2b
LLM_TIMEOUT_S=120

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# elevenlabs | local (faster-whisper, offline) | browser (Chrome Google speech) | none
STT_PROVIDER=elevenlabs
# auto = ElevenLabs first, Google gTTS fallback (rate limit / errors) | elevenlabs | google | none
TTS_PROVIDER=auto
LOCAL_STT_MODEL=small

DATABASE_URL=sqlite:///app.db

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# langextract | json  (json = Gemma JSON + rapidfuzz grounding)
EXTRACTOR=langextract
MAX_QUESTIONS=15
